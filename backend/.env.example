# Copy to .env and fill in real values. NEVER commit the real .env file.

ENV=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/aiml_tutor
# Supabase: postgresql+asyncpg://postgres:<password>@<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiml_tutor

REDIS_URL=redis://localhost:6379/0

ALLOWED_ORIGINS=["http://localhost:5173"]

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_store
MAX_UPLOAD_MB=20

RATE_LIMIT_PER_MINUTE=20
